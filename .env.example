# Leave blank to run fully offline (rule-based planner, templated replies, simulated token counts)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
# Refunds above this amount need human approval
REFUND_LIMIT=5000
# Prices used for the cost dashboard (USD per 1M tokens) - set to your model's real prices
PRICE_IN_PER_M=2.5
PRICE_OUT_PER_M=10.0
